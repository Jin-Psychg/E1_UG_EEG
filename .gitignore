############################################
# 6) results/: ignore outputs by default
############################################

# Ignore everything under results
results/**

# Allow Git to enter folders under results
!results/
!results/**/

# Explicitly keep common result/output files ignored under results
results/**/*.png
results/**/*.jpg
results/**/*.jpeg
results/**/*.gif
results/**/*.bmp
