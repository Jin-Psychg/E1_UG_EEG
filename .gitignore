############################################
# 7) Typical output folders outside results
############################################

# Important:
# Do NOT write "Results/" here, because on Windows it may also match "results/".
# If you have a separate root-level output folder, use a more specific name instead.

Output/
Export/
Figures/
Plots/
Reports/
logs/
log/


############################################
# 8) Keep small templates / examples
############################################

!data_example/
!data_example/**


############################################
# 9) Keep key project files
############################################

!README.md
!LICENSE
!requirements.txt
!environment.yml
!.gitignore

# Single source of truth for ERP component definitions (small text config,
# not data) — must be tracked despite the global *.csv ignore.
!config/erp_components.csv
!config/erp_components_face_E1.csv

# Offer-locked ERP component-definition report (HTML) — tracked despite the
# global *.html ignore.
!ERP_Component_Definitions_OfferLocked.html


############################################
# 10) Keep analysis scripts under results
############################################

# This section must stay at the END of the file.
# It overrides previous ignore rules for scripts inside results.

!results/
!results/**/

# Python / R / MATLAB / shell scripts
!results/**/*.py
!results/**/*.R
!results/**/*.r
!results/**/*.Rmd
!results/**/*.qmd
!results/**/*.m
!results/**/*.jl
